#!/bin/sh
# ==============================================================================
# AUTHOR:      Federico Di Marco (fededim@gmail.com)
# SCRIPT:      ddns-start
# DESCRIPTION: Check both external ipv4 and ipv6 against cloudflare records and, if needed, updates them
# ==============================================================================
# REVISION HISTORY:
# Date        | Version | Author            | Description
# ------------|---------|-------------------|--------------------------------------------
# 2026-07-13  | v1.0.0  | Federico Di Marco | Initial version
# 2026-10-06  | v1.0.1  | Federico Di Marco | Added multi domains and zone record support
# ==============================================================================
# 
# Cloudflare records API https://developers.cloudflare.com/api/resources/dns/subresources/records

API_TOKEN="<cloudflare api token>"      # Your API Token

# List of zone IDs and domains formatted as ZONE_ID:RECORD_NAME
# You can add as many pairs as you need, separated by spaces
DOMAINS_CONFIG="zoneid1:domain1.com zoneid2:domain2.com zoneid3:domain3.com"

RECORD_TTL="1"
UPDATE_IPv6=true

get_dns_records_data() {
  local record_name=$1
  local type=$2
  local api_token=$3
  local zone_id=$4

  # Fetch raw response into a local variable
  local raw_response
  raw_response=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records?type=${type}&name=${record_name}" \
    -H "Authorization: Bearer ${api_token}" \
    -H "Content-Type:application/json")

  # --- LOG THE LOOKUP RESPONSE ---
  logger "Cloudflare GET lookup response for ${type} records: ${raw_response}"

  # Formats it into newline-separated ID:IP entries
  echo "$raw_response" \
    | tr '}' '\n' \
    | grep '"id":' \
    | sed -n 's/.*"id":"\([^"]*\)".*"content":"\([^"]*\)".*/\1:\2/p'
}


update_dns_record() {
  local record_name=$1
  local record_id=$2
  local type=$3
  local ip=$4
  local record_ttl=$5
  local api_token=$6
  local zone_id=$7

  # Capture response to a local variable
  local raw_response
  raw_response=$(curl -s -X PUT "https://api.cloudflare.com/client/v4/zones/${zone_id}/dns_records/${record_id}" \
    -H "Authorization: Bearer ${api_token}" \
    -H "Content-Type: application/json" \
    --data "{\"type\":\"${type}\",\"name\":\"${record_name}\",\"content\":\"${ip}\",\"ttl\":${record_ttl},\"proxied\":true}")

  # --- LOG THE UPDATE RESPONSE ---
  logger "Cloudflare PUT update response for ${type} record ID ${record_id}: ${raw_response}"

  # Output back to the loop for validation
  echo "$raw_response"
}

# --- EXTRACTED PROCESS FUNCTION ---
process_dns_updates() {
  local api_token=$1
  local zone_id=$2
  local record_name=$3
  local ipv4=$4
  local ipv6=$5
  local function_result=1

	# --- PROCESS IPv4 ---
	if [ ! -z "$ipv4" ] && [ "$ipv4" != "0.0.0.0" ] && [ "$ipv4" != "<html>" ]; then
	  A_RECORDS=$(get_dns_records_data "$record_name" "A" "$api_token" "$zone_id")

	  # Loop line-by-line safely by using a standard 'while read' block fed by the variable
	  echo "$A_RECORDS" | while read -r RECORD || [ -n "$RECORD" ]; do
		[ -z "$RECORD" ] && continue

		A_RECORD_ID=$(echo "$RECORD" | cut -d':' -f1)
		CF_IP=$(echo "$RECORD" | cut -d':' -f2-)

		if [ "$ipv4" = "$CF_IP" ]; then
		  logger "IPv4 for ${record_name} is already ${ipv4}. No update needed."
		else
		  logger "IPv4 changed from ${CF_IP} to ${ipv4}. Updating..."
		  RESPONSE="$(update_dns_record "$record_name" "$A_RECORD_ID" "A" "$ipv4" "$RECORD_TTL" "$api_token" "$zone_id")"

		  if echo "$RESPONSE" | grep -q '"success":\ *true'; then
			logger "Updated A record for ${record_name} to ${ipv4}"
		  else
			logger "Unable to update A record for ${record_name} with ${ipv4}"
			function_result=0
		  fi
		fi
	  done
	fi

	# --- PROCESS IPv6 ---
	if [ ! -z "$ipv6" ] && [ "$UPDATE_IPv6" = "true" ] && [ "$ipv6" != "<html>" ] && ip -6 route get "$ipv6" >/dev/null 2>&1; then
	  AAAA_RECORDS=$(get_dns_records_data "$record_name" "AAAA" "$api_token" "$zone_id")

	  echo "$AAAA_RECORDS" | while read -r RECORD || [ -n "$RECORD" ]; do
		[ -z "$RECORD" ] && continue

		AAAA_RECORD_ID=$(echo "$RECORD" | cut -d':' -f1)
		CF_IPv6=$(echo "$RECORD" | cut -d':' -f2-)

		if [ "$ipv6" = "$CF_IPv6" ]; then
		  logger "IPv6 for ${record_name} is already ${ipv6}. No update needed."
		else
		  logger "IPv6 changed from ${CF_IPv6} to ${ipv6}. Updating..."
		  RESPONSE="$(update_dns_record "$record_name" "$AAAA_RECORD_ID" "AAAA" "$ipv6" "$RECORD_TTL" "$api_token" "$zone_id")"

		  if echo "$RESPONSE" | grep -q '"success":\ *true'; then
			logger "Updated AAAA record for ${record_name} to ${ipv6}"
		  else
			logger "Unable to update AAAA record for ${record_name} with ${ipv6}"
			function_result=0
		  fi
		fi
	  done
	fi

  return $function_result
}

RESULT=1

IPv4="${1:-$(curl -s https://api.ipify.org)}"
IPv6="$(curl -s 'https://api6.ipify.org')"

logger "IPV4 ${IPv4} IPV6 ${IPv6} obtained from Router/IPIFY (router params $1 $2)"

# Main execution loop splitting the string configuration pairs
for ITEM in $DOMAINS_CONFIG; do
  CURRENT_ZONE=$(echo "$ITEM" | cut -d':' -f1)
  CURRENT_RECORD=$(echo "$ITEM" | cut -d':' -f2)

  logger "Starting evaluation for ${CURRENT_RECORD} in Zone ${CURRENT_ZONE}"
  
  if process_dns_updates "$API_TOKEN" "$CURRENT_ZONE" "$CURRENT_RECORD" "$IPv4" "$IPv6"; then
    RESULT=0
  fi
done

logger "ddns-start result ${RESULT}"
/sbin/ddns_custom_updated ${RESULT}